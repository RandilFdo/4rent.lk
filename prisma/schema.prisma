// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  phoneNumber     String?
  whatsappNumber  String?
  isAdmin         Boolean  @default(false)
  role            String   @default("user") // user, admin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  favoriteIds     String[] @db.ObjectId

  accounts Account[]
  listings Listing[]
  reservations Reservation[]
  businesses Business[]
  refundRequests RefundRequest[]
}

model Account {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Listing {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  images         String[] // Array of image URLs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Main category (VEHICLE, PROPERTY, or EXPERIENCE)
  mainCategory   String
  
  // Subcategory
  subCategory    String // car, bike, tuktuk, truck, wedding, house, apartment, tour, snorkeling, etc.
  
  // Location fields
  district       String
  city           String
  address        String? // Optional address field
  
  // Pricing
  price          Int
  priceUnit      String // per day, per month, per year
  isNegotiable   Boolean @default(false)
  
  // Contact information
  contactPhone   String
  whatsappNumber String?
  
  // Status and admin controls
  status         String @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  isFeatured     Boolean @default(false)
  featuredUntil  DateTime? // When featured status expires
  adminNotes     String?
  viewCount      Int @default(0)
  expiresAt      DateTime? // Freshness expiry (30 days from approval)
  lastRenewedAt  DateTime?
  
  // Business relation (nullable for individual users)
  businessId     String? @db.ObjectId
  businessVerified Boolean @default(false) // True if posted by verified business
  
  // User relation
  userId         String @db.ObjectId
  
  // Vehicle-specific attributes (JSON for flexibility)
  vehicleAttributes Json?
  
  // Property-specific attributes (JSON for flexibility)
  propertyAttributes Json?

  // Experience-specific attributes (JSON for flexibility)
  experienceAttributes Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  reservations Reservation[]
}

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  listingId String @db.ObjectId  
  startDate DateTime
  endDate DateTime
  totalPrice Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Business {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  businessName String
  logoUrl String? // Business logo URL
  contactPerson String // Contact person name
  contactNumber String // Contact phone
  contactEmail String // Contact email
  category String? // Business category (optional)
  description String? // Short business description
  address String? // Business address (optional)
  status String @default("trial") // trial, active, expired, suspended
  trialEndDate DateTime
  nextPaymentDue DateTime
  autoRenew Boolean @default(false) // Auto-renewal setting
  verified Boolean @default(false) // Verified business badge
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  refundRequests RefundRequest[]
}

model RefundRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  businessId String? @db.ObjectId // Nullable for individual user refunds
  userId String @db.ObjectId
  amount Int
  reason String
  transactionId String? // PayHere transaction ID
  supportingEvidence String? // Additional evidence/notes
  status String @default("pending") // pending, approved, rejected
  processedBy String? // Admin who processed the refund
  processedAt DateTime? // When refund was processed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Banner Ads model for admin management
model BannerAd {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  imageUrl String
  altText String
  landingUrl String
  advertiserName String
  contactPerson String
  contactPhone String
  contactEmail String
  duration String // 1 week, 2 weeks, 1 month, custom
  targetPlacement String // Homepage feed row, Category page, Specific region
  startDate DateTime
  endDate DateTime
  isActive Boolean @default(true)
  paymentStatus String @default("pending") // pending, paid, expired
  adminNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}