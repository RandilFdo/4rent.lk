// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  phoneNumber     String?
  whatsappNumber  String?
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  favoriteIds     String[] @db.ObjectId

  accounts Account[]
  listings Listing[]
  reservations Reservation[]
}

model Account {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Listing {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  images         String[] // Array of image URLs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Main category (VEHICLE or PROPERTY)
  mainCategory   String
  
  // Subcategory
  subCategory    String // car, bike, tuktuk, truck, wedding, house, apartment, etc.
  
  // Location fields
  district       String
  city           String
  address        String? // Optional address field
  
  // Pricing
  price          Int
  priceUnit      String // per day, per month, per year
  isNegotiable   Boolean @default(false)
  
  // Contact information
  contactPhone   String
  whatsappNumber String?
  
  // Status and admin controls
  status         String @default("PENDING") // PENDING, APPROVED, REJECTED
  isFeatured     Boolean @default(false)
  adminNotes     String?
  viewCount      Int @default(0)
  
  // User relation
  userId         String @db.ObjectId
  
  // Vehicle-specific attributes (JSON for flexibility)
  vehicleAttributes Json?
  
  // Property-specific attributes (JSON for flexibility)
  propertyAttributes Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  listingId String @db.ObjectId  
  startDate DateTime
  endDate DateTime
  totalPrice Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}